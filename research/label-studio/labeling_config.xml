<!--
Label Studio config: rotated quad annotation (4 points).
Single class "lockbar". Click 4 corners in order TL → TR → BR → BL.
Export = COCO JSON with polygon coordinates; convert to YOLO-OBB later.
-->
<View>
  <Header value="Click 4 corners of the lockbar: TL, TR, BR, BL"/>
  <Image name="image" value="$image" zoom="true" zoomControl="true"/>
  <PolygonLabels name="poly" toName="image" strokeWidth="3" pointSize="medium" opacity="0.35">
    <Label value="lockbar" background="#00ffff"/>
  </PolygonLabels>
</View>
